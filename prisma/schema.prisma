generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  hashedPassword String?
  nome           String
  cognome        String
  role           UserRole  @default(USER)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  accounts       Account[]
  notificationsSeen NotificationSeen[]
  refreshTokens  RefreshToken[]
  invites        InviteToken[]
  passwordResets PasswordResetToken[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Account {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  iban         String          @unique
  balance  Decimal  @default(0) @db.Decimal(12, 2)
  currency     String          @default("EUR")
  status       AccountStatus   @default(PENDING)
  blockedAt    DateTime?
  cards        Card[]
  transactions Transaction[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model Card {
  id        String     @id @default(uuid())
  accountId String
  account   Account    @relation(fields: [accountId], references: [id])
  numberHash String     @unique
  last4      String
  // Full PAN encrypted with AES-256-GCM (CARD_PAN_SECRET). NULL for cards
  // issued before encrypted storage â€” those can never reveal the full number.
  panEnc     String?
  expiry     String
  holder    String
  status    CardStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([accountId])
}

model Transaction {
  id          String            @id @default(uuid())
  accountId   String
  account     Account           @relation(fields: [accountId], references: [id])
  type        TransactionType
  amount      Decimal           @db.Decimal(12, 2)
  description String
  status      TransactionStatus @default(PENDING)
  reference   String?           @unique
  category    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([accountId])
  @@index([status])
  @@index([createdAt])
  // Exists in the database; the pending-approvals query filters on both.
  @@index([accountId, status])
}

model RefreshToken {
  id         String    @id @default(uuid())
  token      String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  // Present in the database since the table was created by hand; declared here
  // so the schema matches reality instead of showing phantom drift.
  updatedAt  DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model InviteToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  nome      String
  cognome   String
  expiresAt DateTime
  usedAt    DateTime?
  updatedAt   DateTime  @default(now())
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  updatedAt   DateTime  @default(now())
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model RateLimitEntry {
  id      String   @id @default(uuid())
  key     String   @unique
  count   Int      @default(0)
  resetAt DateTime

  @@index([key])
  @@index([resetAt])
}

// Immutable audit trail for sensitive operations (PAN reveals, IBAN changes,
// approvals). Best-effort writes â€” never blocks the underlying operation.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  before    String?
  after     String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// Read-markers only: which events a client has already been shown. The event
// content itself stays derivable from Transaction / Account / AuditLog, so
// nothing is duplicated here. CASCADE so erasing a client erases their markers.
model NotificationSeen {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stable identifier for a derivable event, e.g. `tx:<id>:approved`.
  eventKey String
  seenAt   DateTime @default(now())

  @@unique([userId, eventKey])
  @@index([userId])
}

enum UserRole {
  ADMIN
  USER
}

enum AccountStatus {
  PENDING
  ACTIVE
  FROZEN
  CLOSED
}

enum CardStatus {
  ACTIVE
  FROZEN
  EXPIRED
}

enum TransactionType {
  CREDIT
  DEBIT
  TRANSFER_IN
  TRANSFER_OUT
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
